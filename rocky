#!/usr/bin/env python3
"""Ask RockyGPT a question from the command line, through a website's chat API.

By default it asks the laptop's dev UI. --student asks the laptop's student UI,
--prod asks the real website, the same way a student's browser does, and
--brain PORT asks a laptop Brain straight (with its trace).

`rocky bulk` is the one question runner: every question set, laptop or
production, once or many times. With --out it saves every full reply as JSON
rows ({...the case, answered_at, seconds, body}, plus run with --repeat), the
shape the graders read:

  rocky bulk file rockygpt-evals/fresh-2026-11-03/practice.json --brain 8013 --out run.json
  rocky bulk file rockygpt-evals/tonight-2026-11-02/blind-four-areas --prod --out live.json
      (a folder means its questions-frozen.json; a frozen file is checked against its .sha256)
  rocky bulk file questions.txt --brain 8013 --repeat 5 --out repeat.json

--writer template|ai picks which writer says the answer's facts for this run, whatever the Brain's
settings are (a laptop Brain or the dev UI only; the student site never takes it).
"""

import argparse
import collections
import datetime
import hashlib
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import tempfile
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


ROOT = Path(__file__).resolve().parent


def read_history(path):
    if path is None or not path.exists():
        return []
    messages = json.loads(path.read_text())
    if not isinstance(messages, list) or any(
        not isinstance(message, dict)
        or set(message) != {"role", "content"}
        or not isinstance(message["role"], str)
        or message["role"] not in {"user", "assistant"}
        or not isinstance(message["content"], str)
        or not message["content"].strip()
        for message in messages
    ):
        raise ValueError("history must be a JSON array of {role, content} messages")
    return messages


def save_history(path, messages):
    if path is None:
        return
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        json.dump(messages, handle, indent=2, ensure_ascii=False)
        handle.write("\n")
    try:
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


# Where each target's chat API lives. The student site (laptop or production)
# serves /api/chat; the dev UI serves /api/brain/chat. All take {"messages": [...]}
# and return the Brain's JSON answer.
TARGETS = {
    "dev": (lambda: os.environ.get("ROCKY_DEV_UI", "http://localhost:3100"), "/api/brain/chat"),
    "student": (lambda: os.environ.get("ROCKY_STUDENT_UI", "http://localhost:3000"), "/api/chat"),
    "prod": (lambda: os.environ.get("ROCKY_PROD_SITE", "https://rockygpt.danielrajakumar.com"), "/api/chat"),
}


def chat_url(target="dev"):
    if target.startswith("brain:"):  # a laptop Brain, straight: --brain PORT
        return f"http://127.0.0.1:{target.split(':', 1)[1]}/v1/chat"
    base, path = TARGETS[target]
    return base().rstrip("/") + path


def headers_for(target):
    headers = {"content-type": "application/json", "accept": "application/json"}
    if target.startswith("brain:"):
        headers["x-rockygpt-diagnostics"] = "1"  # the Brain's trace comes back too
    else:
        # One client token per request, like one browser tab each, so a site's per-tab rate
        # limit doesn't refuse a run of many questions.
        headers["x-rockygpt-client"] = secrets.token_hex(16)
    return headers


def ask(question, history, target="dev", writer=None):
    messages = [*history, {"role": "user", "content": question}]
    sent = {"messages": messages, **({"writer": writer} if writer else {})}
    for attempt in range(4):
        request = Request(chat_url(target), data=json.dumps(sent).encode(),
                          headers=headers_for(target))
        try:
            with urlopen(request, timeout=180) as response:
                payload = json.load(response)
            break
        except HTTPError as error:
            if error.code == 429 and attempt < 3:  # rate limited: wait it out, at most 3 times
                time.sleep(int(error.headers.get("retry-after") or 20))
                continue
            raw = error.read().decode(errors="replace")
            try:
                payload = json.loads(raw)
            except ValueError:
                payload = {"error": raw[:500]}
            return {"httpStatus": error.code, "response": payload}, False
        except (URLError, TimeoutError, OSError, ValueError) as error:
            return {"error": str(error)}, False
    if not isinstance(payload, dict) or not isinstance(payload.get("answer"), str) or not payload["answer"].strip():
        return {"error": "The Brain returned an incomplete answer.", "response": payload}, False
    history[:] = [*messages, {"role": "assistant", "content": payload["answer"]}]
    return payload, True


def load_cases(path):
    """A question set as cases: a folder (its questions-frozen.json, hash-checked against
    questions-frozen.sha256, else questions.json), a JSON list of {"id", "question", ...} or of
    strings, or a text file with one question per line (# comments skipped). A question with
    " || " is a conversation: each piece is the next user message."""
    path = Path(path)
    if path.is_dir():
        frozen = path / "questions-frozen.json"
        path = frozen if frozen.exists() else path / "questions.json"
    content = path.read_text()
    digest = path.with_suffix(".sha256")
    if digest.exists():
        want = digest.read_text().split()[0]
        if hashlib.sha256(content.encode()).hexdigest() != want:
            raise ValueError(f"{path} changed since it was frozen ({digest.name} does not match)")
    items = json.loads(content) if content.lstrip().startswith("[") else content.splitlines()
    if not isinstance(items, list):
        raise ValueError("questions must be a JSON list or one question per line")
    cases = []
    for item in items:
        if isinstance(item, str):
            if item.strip() and not item.lstrip().startswith("#"):
                cases.append({"id": f"q{len(cases) + 1}", "question": item.strip()})
        elif isinstance(item, dict) and isinstance(item.get("question"), str) and item["question"].strip():
            cases.append(dict(item, id=item.get("id") or f"q{len(cases) + 1}"))
        else:
            raise ValueError("each question must be a string or an object with a question")
    return cases


def run_case(case, target):
    """Ask one case (every turn of a conversation) and keep the last full reply."""
    history = []
    answered_at = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    started = time.time()
    body = {}
    for turn in case["question"].split(" || "):
        payload, ok = ask(turn.strip(), history, case["_target"], case.get("_writer"))
        # A reply with no written answer (a json-output Brain, say) is still the reply to grade.
        body = payload.get("response", payload) if not ok and "httpStatus" not in payload else payload
        if not ok:
            break
    row = {key: value for key, value in case.items() if key not in ("_target", "_writer")}
    return {**row, "answered_at": answered_at, "seconds": round(time.time() - started, 1), "body": body}


def run_to_file(cases, target, out, parallel, repeat, writer=None):
    jobs = [dict(case, _target=target, _writer=writer, **({"run": run} if repeat > 1 else {}))
            for run in range(1, repeat + 1) for case in cases]
    done, lock = [0], threading.Lock()

    def one(case):
        row = run_case(case, target)
        with lock:
            done[0] += 1
            status = row["body"].get("status") or "ERROR"
            print(f"{done[0]}/{len(jobs)}  {status:<12} {row['seconds']:>5}s  {row['id']}", flush=True)
        return row

    with ThreadPoolExecutor(max(1, parallel)) as pool:
        rows = list(pool.map(one, jobs))
    Path(out).write_text(json.dumps(rows, indent=1, ensure_ascii=False) + "\n")
    statuses = collections.Counter(row["body"].get("status") or "ERROR" for row in rows)
    print(f"\nSaved {len(rows)} replies to {out}: {dict(statuses)}")
    areas = collections.Counter(row["area"] for row in rows if row.get("area"))
    for area, count in areas.items():
        print(f"  {area}: {count}")
    return 1 if statuses.get("ERROR") else 0


def print_response(payload, raw=False):
    subprocess.run(
        [sys.executable, str(ROOT / "rocky-format.py"), *(["--raw"] if raw else [])],
        input=json.dumps(payload), text=True, check=True,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    where = argparse.ArgumentParser(add_help=False)
    which = where.add_mutually_exclusive_group()
    which.add_argument("--prod", dest="target", action="store_const", const="prod",
                       help="ask the real website (rockygpt.danielrajakumar.com)")
    which.add_argument("--student", dest="target", action="store_const", const="student",
                       help="ask the laptop's student UI (localhost:3000)")
    which.add_argument("--brain", dest="target", type=lambda port: f"brain:{int(port)}",
                       metavar="PORT", help="ask a laptop Brain straight, with its trace (e.g. 8013)")
    where.set_defaults(target="dev")
    where.add_argument("--writer", choices=["template", "ai"],
                       help="which writer says the facts (laptop Brain or dev UI only)")
    commands = parser.add_subparsers(dest="command", required=True)
    one = commands.add_parser("ask", parents=[where], help="ask one student question")
    one.add_argument("question")
    one.add_argument("--raw", action="store_true", help="print the complete response JSON")
    one.add_argument("--history", type=Path, help="read and update this JSON messages file")
    bulk = commands.add_parser("bulk", parents=[where], help="ask a sample set or a questions file")
    bulk.add_argument("set", choices=["short", "full", "file"])
    bulk.add_argument("arguments", nargs="*", metavar="PATH_OR_DELAY_MS")
    bulk.add_argument("--history", type=Path, help="preserve and save conversation history")
    bulk.add_argument("--out", type=Path, help="save every full reply as JSON rows (for grading)")
    bulk.add_argument("--parallel", type=int, default=2, help="questions at a time with --out (default 2)")
    bulk.add_argument("--repeat", type=int, default=1, help="ask each question this many times (with --out)")
    bulk.add_argument("--only", help="comma-separated question ids to ask (with --out)")
    args = parser.parse_args()
    if args.writer and args.target in ("prod", "student"):
        parser.error("--writer is for a laptop Brain or the dev UI; the student site never takes it")

    try:
        history = read_history(args.history)
        if args.command == "ask":
            if not args.question.strip():
                parser.error("question must not be empty")
            payload, ok = ask(args.question, history, args.target, args.writer)
            if ok:
                save_history(args.history, history)
            print_response(payload, args.raw)
            return 0 if ok else 1

        arguments = list(args.arguments)
        if args.set == "file":
            if not arguments:
                parser.error("bulk file requires a path")
            questions_path = Path(arguments.pop(0))
        else:
            name = "short-run-questions.json" if args.set == "short" else "capability-test-questions.json"
            questions_path = ROOT / "rockygpt-dev" / "lib" / name
        cases = load_cases(questions_path)
        if args.out:
            if args.history or arguments:
                parser.error("--out asks each question on its own; drop --history and the delay")
            if args.repeat < 1:
                parser.error("--repeat must be 1 or more")
            if args.only:
                wanted = set(args.only.split(","))
                cases = [case for case in cases if case["id"] in wanted]
            return run_to_file(cases, args.target, args.out, args.parallel, args.repeat, args.writer)
        if args.repeat != 1 or args.only:
            parser.error("--repeat and --only need --out")
        if len(arguments) > 1:
            parser.error("only one delay in milliseconds is allowed")
        delay = float(arguments[0]) / 1000 if arguments else 0
        if not 0 <= delay < float("inf"):
            parser.error("delay must be finite and nonnegative")
        questions = [case["question"] for case in cases]
        failures = 0
        for index, question in enumerate(questions, 1):
            payload, ok = ask(question, history if args.history else [], args.target, args.writer)
            failures += not ok
            if ok:
                save_history(args.history, history)
            print(f"\n{index}/{len(questions)}  {question}", flush=True)
            print_response(payload)
            if delay and index < len(questions):
                time.sleep(delay)
        print(f"\nFinished {len(questions)} questions; {failures} request failures.")
        return 1 if failures else 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"rocky: {error}\n")


if __name__ == "__main__":
    raise SystemExit(main())
