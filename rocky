#!/usr/bin/env python3
"""Ask the Brain through the Dev UI using the public messages contract."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


ROOT = Path(__file__).resolve().parent


def read_history(path):
    if path is None or not path.exists():
        return []
    messages = json.loads(path.read_text())
    if not isinstance(messages, list) or any(
        not isinstance(message, dict)
        or set(message) != {"role", "content"}
        or not isinstance(message["role"], str)
        or message["role"] not in {"user", "assistant"}
        or not isinstance(message["content"], str)
        or not message["content"].strip()
        for message in messages
    ):
        raise ValueError("history must be a JSON array of {role, content} messages")
    return messages


def save_history(path, messages):
    if path is None:
        return
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        json.dump(messages, handle, indent=2, ensure_ascii=False)
        handle.write("\n")
    try:
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def ask(question, history):
    endpoint = os.environ.get("ROCKY_DEV_UI", "http://localhost:3100").rstrip("/")
    messages = [*history, {"role": "user", "content": question}]
    request = Request(
        endpoint + "/api/brain/chat",
        data=json.dumps({"messages": messages}).encode(),
        headers={"content-type": "application/json", "accept": "application/json"},
    )
    try:
        with urlopen(request, timeout=180) as response:
            payload = json.load(response)
    except HTTPError as error:
        raw = error.read().decode(errors="replace")
        try:
            payload = json.loads(raw)
        except ValueError:
            payload = {"error": raw[:500]}
        return {"httpStatus": error.code, "response": payload}, False
    except (URLError, TimeoutError, OSError, ValueError) as error:
        return {"error": str(error)}, False
    if not isinstance(payload, dict) or not isinstance(payload.get("answer"), str) or not payload["answer"].strip():
        return {"error": "The Brain returned an incomplete answer.", "response": payload}, False
    history[:] = [*messages, {"role": "assistant", "content": payload["answer"]}]
    return payload, True


def print_response(payload, raw=False):
    subprocess.run(
        [sys.executable, str(ROOT / "rocky-format.py"), *(["--raw"] if raw else [])],
        input=json.dumps(payload), text=True, check=True,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    one = commands.add_parser("ask", help="ask one student question")
    one.add_argument("question")
    one.add_argument("--raw", action="store_true", help="print the complete response JSON")
    one.add_argument("--history", type=Path, help="read and update this JSON messages file")
    bulk = commands.add_parser("bulk", help="ask a sample set or a questions file")
    bulk.add_argument("set", choices=["short", "full", "file"])
    bulk.add_argument("arguments", nargs="*", metavar="PATH_OR_DELAY_MS")
    bulk.add_argument("--history", type=Path, help="preserve and save conversation history")
    args = parser.parse_args()

    try:
        history = read_history(args.history)
        if args.command == "ask":
            if not args.question.strip():
                parser.error("question must not be empty")
            payload, ok = ask(args.question, history)
            if ok:
                save_history(args.history, history)
            print_response(payload, args.raw)
            return 0 if ok else 1

        arguments = list(args.arguments)
        if args.set == "file":
            if not arguments:
                parser.error("bulk file requires a path")
            questions_path = Path(arguments.pop(0))
        else:
            name = "short-run-questions.json" if args.set == "short" else "capability-test-questions.json"
            questions_path = ROOT / "rockygpt-dev" / "lib" / name
        if len(arguments) > 1:
            parser.error("only one delay in milliseconds is allowed")
        delay = float(arguments[0]) / 1000 if arguments else 0
        if not 0 <= delay < float("inf"):
            parser.error("delay must be finite and nonnegative")
        content = questions_path.read_text()
        questions = json.loads(content) if content.lstrip().startswith("[") else content.splitlines()
        if not isinstance(questions, list) or any(not isinstance(item, str) for item in questions):
            parser.error("questions must be a JSON string array or one question per line")
        questions = [question.strip() for question in questions if question.strip() and not question.lstrip().startswith("#")]
        failures = 0
        for index, question in enumerate(questions, 1):
            payload, ok = ask(question, history if args.history else [])
            failures += not ok
            if ok:
                save_history(args.history, history)
            print(f"\n{index}/{len(questions)}  {question}", flush=True)
            print_response(payload)
            if delay and index < len(questions):
                time.sleep(delay)
        print(f"\nFinished {len(questions)} questions; {failures} request failures.")
        return 1 if failures else 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"rocky: {error}\n")


if __name__ == "__main__":
    raise SystemExit(main())
