{
  "brain": {
    "directory": "rockygpt-brain",
    "local_file": "rockygpt-brain/.env.local",
    "settings": {
      "BRAIN_ENVIRONMENT": "development",
      "BRAIN_OPENAI_PROJECT": "proj_aMhXgndK2e9EUQZpXbLFh4yV",
      "BRAIN_ROUTING_MODE": "active",
      "BRAIN_ROUTING_PROVIDER": "typesafe"
    },
    "sources": [
      {
        "path": "~/.config/rockygpt/rockygpt.env",
        "keys": {
          "DATABASE_URL": "LOCAL_DATABASE_URL",
          "BRAIN_LEDGER_DATABASE_URL": "LOCAL_LEDGER_DATABASE_URL",
          "BRAIN_OPENAI_API_KEY": "BRAIN_OPENAI_API_KEY",
          "BRAIN_TYPESAFE_API_KEY": "BRAIN_TYPESAFE_API_KEY",
          "VOYAGE_API_KEY": "VOYAGE_API_KEY"
        }
      }
    ]
  },
  "data": {
    "directory": "rockygpt-data",
    "settings": {},
    "sources": [
      {
        "path": "~/.config/rockygpt/rockygpt.env",
        "keys": {
          "DATABASE_URL": "PRODUCTION_DATABASE_URL",
          "RAW_ARTIFACT_ACCESS_KEY_ID": "RAW_ARTIFACT_ACCESS_KEY_ID",
          "RAW_ARTIFACT_SECRET_ACCESS_KEY": "RAW_ARTIFACT_SECRET_ACCESS_KEY"
        }
      }
    ]
  },
  "dev-production": {
    "directory": "rockygpt-dev",
    "settings": {
      "BRAIN_URL": "https://rockygpt-brain.onrender.com"
    },
    "sources": [
      {
        "path": "~/.config/rockygpt/rockygpt.env",
        "keys": {
          "STAGING_SERVICE_TOKEN": "PRODUCTION_SERVICE_TOKEN"
        }
      }
    ]
  }
}
